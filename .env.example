# Copy to .env and change the password.
POSTGRES_PASSWORD=change-me

# A free CourtListener API token (https://www.courtlistener.com/sign-in/). Needed to collect
# new court decisions; existing decisions stay on the site without it.
COURTLISTENER_API_TOKEN=

# Earliest Supreme Court decision date to collect (legislative data starts in 1991).
COURT_CASES_SINCE=1991-01-01

# Hour of day (Pacific time) for the daily refresh.
SYNC_HOUR_LOCAL=5

# Host ports (both are bound to 127.0.0.1 only).
WEB_HOST_PORT=8095
DB_HOST_PORT=55440

# Contact form email delivery (optional). Messages are always saved in the database;
# when these are set they're also emailed. Keep the recipient address out of the code.
CONTACT_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail: an App Password (Google Account > Security > App passwords), not your normal password.
SMTP_PASSWORD=
# Public address of the site: used for canonical links, the sitemap, and contact emails. When set,
# requests for www.<this host> and *.up.railway.app are redirected here.
SITE_URL=

# Optional: a free Socrata app token (https://data.wa.gov/profile/edit/developer_settings) raises the
# rate limit for campaign-money data from the Public Disclosure Commission. Works fine without one.
SOCRATA_APP_TOKEN=
